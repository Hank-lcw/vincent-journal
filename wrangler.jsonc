{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vincent-journal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vincent-journal-runtime",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "vincent-journal-media" },
    { "binding": "BACKUPS", "bucket_name": "vincent-journal-backups" }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://vincent-journal.andyhank1234567890.workers.dev",
    "TEAM_DOMAIN": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
    "POLICY_AUD": "REPLACE_WITH_ACCESS_AUD",
    "BOOTSTRAP_ADMIN_EMAIL": "andyhank1234567890@gmail.com",
    "MAIL_FROM": "VINCENT JOURNAL <journal@YOUR_VERIFIED_MAIL_DOMAIN>",
    "RESEND_SEGMENT_ID": "REPLACE_WITH_RESEND_SEGMENT_ID",
    "META_GRAPH_VERSION": "v24.0",
    "CANVA_REDIRECT_URI": "https://vincent-journal.andyhank1234567890.workers.dev/api/oauth/canva/callback",
    "FACEBOOK_REDIRECT_URI": "https://vincent-journal.andyhank1234567890.workers.dev/api/oauth/facebook/callback",
    "INSTAGRAM_REDIRECT_URI": "https://vincent-journal.andyhank1234567890.workers.dev/api/oauth/instagram/callback",
    "THREADS_REDIRECT_URI": "https://vincent-journal.andyhank1234567890.workers.dev/api/oauth/threads/callback",
    "XHS_REDIRECT_URI": "https://vincent-journal.andyhank1234567890.workers.dev/api/oauth/xiaohongshu/callback"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "17 3 * * *"]
  },
  "observability": { "enabled": true }
}
